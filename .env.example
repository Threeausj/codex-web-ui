# Backend binds to loopback. Vite development UI uses port 5173.
HOST=127.0.0.1
PORT=8787

# Leave empty only for local development: a random password is created in
# DATA_DIR/bootstrap-password.txt. For public deployment set >= 12 characters.
# Initial credential only: persisted DATA_DIR/web-password.json takes precedence.
# Change the access password under Settings > Account > Web access.
CODEX_WEB_PASSWORD=

# Exact browser origins, comma-separated; no trailing slash or URL path.
# Production example: https://codex.example.com
PUBLIC_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Use an existing installation; the application never installs or updates Codex.
# Docker: SSH uses the remote CLI. Local execution needs compose.host-codex.yaml
# and an absolute container CODEX_BIN pointing into its read-only host mount.
# spawn: codex app-server --listen stdio://
# proxy: codex app-server proxy [--sock CODEX_SOCKET_PATH]
CODEX_BIN=codex
CODEX_CONNECTION_MODE=spawn
# App-server clientInfo.name; controls the originator of new conversations.
# Use a client identifier accepted by your configured gateway.
CODEX_CLIENT_NAME=codex_web
# Optional absolute path for an already-running app-server control socket.
# CODEX_SOCKET_PATH=/absolute/path/app-server-control.sock
# Optional; inherits the current user's ~/.codex by default.
# CODEX_HOME=/absolute/path/.codex

# Web-owned project/SSH metadata, local password and private Web Push state.
DATA_DIR=.data

# Optional standard Web Push. Leave both keys empty for automatic generation;
# DATA_DIR/push-vapid.json must persist across server restarts (mode 0600).
# When supplying existing keys, set BOTH values; keep the private key secret.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Optional VAPID contact: use a real maintainer email for public deployment.
# Defaults to the first HTTPS PUBLIC_ORIGIN, or the project's GitHub URL locally.
# Example: mailto:admin@example.com (replace with your actual address)
PUSH_SUBJECT=

# Optional: frontend assets when the service starts from a separate workspace.
# STATIC_DIR=/absolute/path/codex-web-ui/dist

# Enable only behind a trusted reverse proxy with no direct backend access.
TRUST_PROXY=0
NODE_ENV=development
