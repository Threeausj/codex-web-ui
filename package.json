{
  "name": "codex-web-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts server/*.test.ts",
    "protocol:generate": "codex app-server generate-ts --experimental --out shared/protocol",
    "test:e2e": "playwright test",
    "docs:screenshots": "tsx scripts/readme-screenshots.ts",
    "doctor": "tsx scripts/doctor.ts",
    "doctor:daemon": "tsx scripts/daemon-doctor.ts",
    "doctor:preview": "tsx scripts/preview-smoke.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.3.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-vue-next": "^0.468.0",
    "marked": "^16.4.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "^6.4.299",
    "vue": "^3.5.22",
    "web-push": "^3.6.7",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "overrides": {
    "concurrently": {
      "shell-quote": "^1.11.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vue-tsc": "^3.1.1"
  }
}
