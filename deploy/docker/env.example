# Copy to .env.docker. Do not commit the populated file.
# Use a newly generated password with at least 12 characters (32+ recommended).
# Example generation: openssl rand -hex 32
# Initial credential only; webdata/web-password.json takes precedence after startup.
# Change it under Settings > Account > Web access; preserve the webdata volume.
CODEX_WEB_PASSWORD=

# Build uses the protocol-compatible CLI baseline, rather than floating latest.
CODEX_VERSION=0.159.2

# Host directory mounted writable at /workspace; create it before starting.
# Linux: the container runs as UID/GID 1000; grant that user access to this folder.
WORKSPACE_PATH=./workspace

# Only needed with compose.public.yaml. DNS must point here; open TCP80/443.
PUBLIC_HOST=codex.example.com
ACME_EMAIL=admin@example.com

# Optional Web Push. Both keys empty => automatically generated in webdata.
# Persist/backup webdata to preserve keys and authorized device subscriptions.
# Supply BOTH keys only if you already manage a VAPID key pair; never commit it.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
# Optional public deployment contact: mailto:your-actual-maintainer-email
# Empty defaults to the HTTPS public origin (project GitHub URL for local HTTP).
PUSH_SUBJECT=
